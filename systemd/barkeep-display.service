[Unit]
Description=Apple T1 Touch Bar display session (USB config 2)
Documentation=https://github.com/xeeban/macbook-t1-linux
# NOTE: do NOT order After=multi-user.target while also being WantedBy it -
# that forms an ordering cycle and systemd silently drops the dependent job.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
# Not a fixed sysfs path: the iBridge is 1-3 on a MacBookPro13,2, but that is
# where the controller sits, not a property of the device. ExecCondition looks
# it up by USB id and skips the unit cleanly (not "failed") if it is absent.
# The old stock-function-row units run touchbar-rebind, which loads
# apple-ibridge; appleib_hid_probe() then force-selects USB config 1 and kills
# the display session. install.sh disables them, but declare it too so a manual
# `systemctl start touchbar` cannot silently blank the bar.
Conflicts=touchbar.service touchbar-resume.service
After=touchbar.service touchbar-resume.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/usr/local/lib/barkeep/have-ibridge.sh
ExecStart=/usr/local/lib/barkeep/dfr-up.sh
ExecStop=/usr/local/lib/barkeep/dfr-reset.sh
TimeoutStartSec=90
# dfr-reset.sh re-enumerates USB and can take a while; without this the
# default 90s/5s stop timeout kills it half-done and leaves the panel dark.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
